<!DOCTYPE html>
<html lang="id">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Edit User</title>
  <link rel="stylesheet" href="/styles.css">
</head>
<body>
  <main class="form-shell">
    <header class="topbar">
      <div class="brand">
        <span class="eyebrow">Update Data</span>
        <h1>Edit User</h1>
        <p class="subtitle">Perbarui nama atau email pengguna yang sudah tersimpan.</p>
      </div>
    </header>

    <section class="panel form-card">
      <form class="form-grid" action="/edit/<%= user.id %>" method="POST">
        <div class="field">
          <label for="name">Nama</label>
          <input id="name" name="name" type="text" value="<%= user.name %>" required>
        </div>

        <div class="field">
          <label for="email">Email</label>
          <input id="email" name="email" type="email" value="<%= user.email %>" required>
        </div>

        <div class="form-actions">
          <a class="btn secondary" href="/">Kembali</a>
          <button class="btn" type="submit">Update</button>
        </div>
      </form>
    </section>
  </main>
</body>
</html>
